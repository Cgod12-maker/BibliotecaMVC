@page
@model AccessDeniedModel
@{
    ViewData["Title"] = "Acceso denegado";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-danger shadow">
                <div class="card-header bg-danger text-white">
                    <h3 class="mb-0">🚫 Acceso denegado</h3>
                </div>
                <div class="card-body">
                    <p class="lead">No tienes los permisos necesarios para realizar esta operación.</p>
                    <p>Si crees que esto es un error, contacta al administrador del sistema.</p>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Volver al inicio</a>
                    <a asp-controller="Libros" asp-action="Index" class="btn btn-secondary">Ir a Libros</a>
                </div>
            </div>
        </div>
    </div>
</div>