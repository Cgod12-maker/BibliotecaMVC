@{
    ViewData["Title"] = "Error";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 text-center">
            <h1 class="display-1 text-danger">¡Ups!</h1>
            <h2 class="text-danger">Ha ocurrido un error inesperado.</h2>
            <p class="lead">Lo sentimos, algo salió mal. Por favor, intenta nuevamente más tarde.</p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Volver al inicio</a>
        </div>
    </div>
</div>