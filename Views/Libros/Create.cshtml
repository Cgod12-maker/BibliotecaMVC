@model IEnumerable<BibliotecaMVC.Models.Libro>
@{
    ViewData["Title"] = "Libros";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Catalogo de Libros</h1>
    <a asp-action="Create" class="btn btn-primary">Agregar Libro</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        No hay libros registrados aun. Agrega el primero.
    </div>
}
else
{
    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-4 mb-3">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <h5 class="card-title">@item.Titulo</h5>
                        <h6 class="card-subtitle mb-2 text-muted">@item.Autor</h6>
                        <p class="card-text">
                            <span class="badge bg-secondary">@item.Genero</span><br />
                            <small class="text-muted">
                                Anio: @item.AnioPublicacion - @item.NumeroPaginas paginas
                            </small>
                        </p>
                        <div class="d-flex gap-2">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Editar</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Eliminar</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}